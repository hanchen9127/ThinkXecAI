<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thinkxecai.mapper.ChatSessionMapper">

    <sql id="columns">id, agent_id, title, created_at, updated_at</sql>

    <!-- Timestamps are left to the column defaults and read back with the generated id. -->
    <insert id="insert" useGeneratedKeys="true"
            keyProperty="id,createdAt,updatedAt" keyColumn="id,created_at,updated_at">
        INSERT INTO chat_session (agent_id, title)
        VALUES (#{agentId}, #{title})
    </insert>

    <select id="selectById" resultType="com.thinkxecai.model.entity.ChatSessionEntity">
        SELECT <include refid="columns"/>
        FROM chat_session
        WHERE id = #{id}
    </select>

    <!--
        Before adding a message: the same lock the touch that follows takes, so the session cannot be
        deleted or lose its agent meanwhile, and two messages to one session take turns instead of
        deadlocking on the touch (ADR 037).
    -->
    <select id="selectByIdForNoKeyUpdate" resultType="com.thinkxecai.model.entity.ChatSessionEntity">
        SELECT <include refid="columns"/>
        FROM chat_session
        WHERE id = #{id}
        FOR NO KEY UPDATE
    </select>

    <select id="listAll" resultType="com.thinkxecai.model.entity.ChatSessionEntity">
        SELECT <include refid="columns"/>
        FROM chat_session
        ORDER BY updated_at DESC
    </select>

    <select id="listByAgentId" resultType="com.thinkxecai.model.entity.ChatSessionEntity">
        SELECT <include refid="columns"/>
        FROM chat_session
        WHERE agent_id = #{agentId}
        ORDER BY updated_at DESC
    </select>

    <update id="update">
        UPDATE chat_session
        <set>
            <if test="title != null">title = #{title},</if>
            updated_at = now()
        </set>
        WHERE id = #{id}
    </update>

    <update id="touch">
        UPDATE chat_session
        SET updated_at = now()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM chat_session
        WHERE id = #{id}
    </delete>

</mapper>
