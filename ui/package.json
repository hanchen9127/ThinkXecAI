{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../backend/target/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/x": "2.9.0",
    "@ant-design/x-markdown": "2.9.0",
    "antd": "6.6.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
