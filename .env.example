THINKXECAI_DB_PASSWORD=
THINKXECAI_GEMINI_API_KEY=
THINKXECAI_DEEPSEEK_API_KEY=
# Alibaba Cloud Model Studio key for qwen3.8-flash (international site, dashscope-intl).
THINKXECAI_QWEN_API_KEY=
THINKXECAI_QWEN_API_KEY=

# Optional: the email tool (Gmail API, OAuth 2.0 with the gmail.send scope). Checked at the first send, not at startup.
THINKXECAI_GMAIL_SENDER=
THINKXECAI_GMAIL_CLIENT_ID=
THINKXECAI_GMAIL_CLIENT_SECRET=
THINKXECAI_GMAIL_REFRESH_TOKEN=
# Comma-separated recipients the email tool may send to. Empty disables sending.
THINKXECAI_MAIL_ALLOWED_RECIPIENTS=
